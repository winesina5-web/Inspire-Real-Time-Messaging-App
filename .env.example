# Browser-safe Supabase project URL
VITE_SUPABASE_URL=

# Supabase publishable key only. Never put a service-role/secret key in VITE_ variables.
VITE_SUPABASE_ANON_KEY=

# Public URL of the separately deployed inspire-worker Cloudflare Worker, e.g. https://inspire-worker.<account-subdomain>.workers.dev
# Required for Workers AI and Worker-backed utility endpoints. Supabase Storage media uploads use Supabase directly.
VITE_WORKER_API_URL=
